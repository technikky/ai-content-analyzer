# Copy to .env and fill in. Never commit .env.
# No key is needed for the default analyzers: the lexicon, rule-based extractor,
# extractive summariser and extractive QA are all local. These are only for --llm-analyses.

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Where `analyzer serve` looks for a prebuilt document library.
ANALYZER_LIBRARY_DIR=/app/library

# Read by the Next.js frontend at build and run time.
NEXT_PUBLIC_API_URL=http://localhost:8000
